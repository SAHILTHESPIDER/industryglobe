rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /issueReports/{reportId} {
      allow create: if request.auth != null
        && request.resource.data.issue_id == reportId
        && request.resource.data.status == 'new'
        && request.resource.data.source == 'in_app_support'
        && request.resource.data.details is string
        && request.resource.data.detail_length is int
        && request.resource.data.detail_length <= 500;

      allow read, update, delete: if false;
    }

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function walletFields() {
      return [
        'premium',
        'premiumBalance',
        'premiumSkillPoints',
        'lifetimePremium',
        'lifetimeCredited',
        'lifetimeSpent',
        'characterUnlock',
        'skillPoints',
        'receipts',
        'spends'
      ];
    }

    match /players/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid) && !request.resource.data.keys().hasAny(walletFields());
      allow update: if isOwner(uid)
        && !request.resource.data.keys().hasAny(walletFields())
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(walletFields());
      allow delete: if false;

      match /wallet/{docId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      match /receipts/{receiptId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }
    }
  }
}
